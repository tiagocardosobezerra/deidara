	partition Funcionarios = m
		mode: import
		source =
				let
				    Fonte = Sql.Database("SRV-RH", "RH"),
				    Dados = Value.NativeQuery(Fonte, "SELECT * FROM dbo.FUNCIONARIOS")
				in
