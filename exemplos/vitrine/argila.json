      "nome": "Tempo de Casa Médio",
      "dax": "VAR _fim = MIN(MAX(dCalendario[Data]), TODAY())\nRETURN\n    AVERAGEX(\n        FILTER(\n            dColaborador,\n            VAR _saida = CALCULATE(MAX(fDesligamento[Data do Desligamento]), REMOVEFILTERS(dCalendario))\n            RETURN dColaborador[Data de Admissão] <= _fim && (ISBLANK(_saida) || _saida > _fim)\n        ),\n        DATEDIFF(dColaborador[Data de Admissão], _fim, DAY) / 365.25\n    )",
